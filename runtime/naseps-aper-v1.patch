+        assertEquals("A", AsnAper.string(in, range("0:1"), false, false)); assertTrue(in.readBit());
+    }
+    @Test void octetFragmentationMatchesExternalHashesAndKeepsFollowingAlignment() throws Exception {
+        Map<Integer, String> hashes = Map.of(127, "227f01634df32d10bcbd1886db15dbce112b40711ce02c98facbc8883c28066f",
+                128, "48d156208a9c79460bc7db38f97aa05f017e846eaf67e6e7d35d1e64b9c90fe8",
+                16383, "f2452d3154082f1973373ace66deb8c26c76e51071fa4cc6c4612295fffa92fa",
+                16384, "51b5d8e425ae30f8004cb03275b3a2fbdd525576ee1b5cb6c693d9347f6198ba",
+                65536, "36ee04f4e7b10b05f14ca79e9aad42f040c3d5d2f0c78c192997b6d8040bbac7",
+                65537, "7e7355653f9ef84f36b215725fcd9bf4a936b30de38f059fe064b3d7c146e953");
+        for (var e : hashes.entrySet()) {
+            byte[] bytes = new byte[e.getKey()]; Arrays.fill(bytes, (byte) 0x55);
+            byte[] encoded = framed(out -> AsnAper.octets(out, bytes, null, false, true));
+            assertEquals(e.getValue(), hex(MessageDigest.getInstance("SHA-256").digest(encoded)));
+            BitInput in = new BitInput(encoded); assertTrue(in.readBit());
+            assertArrayEquals(bytes, AsnAper.octets(in, null, false, true)); assertTrue(in.readBit());
+        }
+    }
+    @Test void bitFragmentationMatchesExternalHashes() throws Exception {
+        for (int length : List.of(16384, 65537)) {
+            byte[] bytes = new byte[(length + 7) / 8]; Arrays.fill(bytes, (byte) 0xff);
+            AsnBitString.Value value = new AsnBitString.Value(bytes, length);
+            byte[] encoded = framed(out -> AsnAper.bits(out, value, null, false, true));
+            assertEquals(length == 16384 ? "6eafbe1ab0bd50f82de97aeee0e39488e146056ab35a3125158df9820968cf75"
+                    : "e91da06b6a714e2d7bdd7f09457bacb7b516f2af2ab52ad4a5fefbc343cd0b2b",
+                    hex(MessageDigest.getInstance("SHA-256").digest(encoded)));
+            BitInput in = new BitInput(encoded); assertTrue(in.readBit());
+            assertEquals(length, AsnAper.bits(in, null, false, true).getBitLength()); assertTrue(in.readBit());
+        }
+    }
+    @Test void listAndSequenceAdditionExternalVectors() {
+        assertEquals("800003b0", hex(framed(out -> AsnAper.list(out, List.of(1, 0, 1), range("0:65535"), false, true,
+                (target, value) -> target.writeBit(value == 1)))));
+        BitOutput out = new BitOutput(); out.writeBit(true); out.writeBits(5, 3);
+        AsnAper.extensions(out, target -> target.writeBits(255, 8), target -> AsnAper.octets(target, new byte[] {0x12}, null, false, true));
+        // Confirmed independently with asn1tools 0.167.0; pycrate 0.8.1 adds
+        // an extra alignment octet after the extension bitmap in this fixture.
+        assertEquals("d03801ff020112", hex(out.toByteArray()));
+        BitInput in = new BitInput(out.toByteArray()); assertTrue(in.readBit()); assertEquals(5, in.readBitsInt(3));
+        BitInput[] additions = AsnAper.extensions(in, 2);
+        assertEquals(255, additions[0].readBitsInt(8)); AsnAper.finishOpen(additions[0]);
+        assertArrayEquals(new byte[] {0x12}, AsnAper.octets(additions[1], null, false, true)); AsnAper.finishOpen(additions[1]);
+    }
+    @Test void normallySmallAndLongExtensionBitmaps() {
+        for (int value : List.of(0, 63, 64, 255, 256, 65535)) {
+            BitOutput out = new BitOutput(); out.writeBit(true); AsnAper.normallySmall(out, value); out.writeBit(true);
+            BitInput in = new BitInput(out.toByteArray()); assertTrue(in.readBit()); assertEquals(value, AsnAper.normallySmall(in)); assertTrue(in.readBit());
+        }
+        InformationElement[] values = new InformationElement[65]; values[64] = out -> out.writeBits(7, 8);
+        BitOutput out = new BitOutput(); AsnAper.extensions(out, values);
+        BitInput[] decoded = AsnAper.extensions(new BitInput(out.toByteArray()), 65); assertEquals(7, decoded[64].readBitsInt(8));
+    }
+    @Test void malformedValuesAreRejected() {
